{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set ANALISE_BETS_AMBIENTE=dev&& python -m uvicorn src.api.main:app --port 8000"],
